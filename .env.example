# PostgreSQL. Use a separate development database/branch, never production for tests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Trusted app origin for authenticated PDF export (HTTPS in production).
APP_URL="http://localhost:3000"
JWT_SECRET=""
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
NVIDIA_NIM_API_KEY=""
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
NVIDIA_NIM_THINKING="false"
AI_TIMEOUT_MS="45000"
AI_MAX_TOKENS="8000"
ANALYSIS_DAILY_LIMIT="40"
# Remains disabled until a real, tested gateway adapter is registered.
BILLING_ENABLED="false"
BILLING_PROVIDER=""
BILLING_OFFER_ID=""
# See docs/neon-auth-setup.md for Neon Auth variables.
# CHROME_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
